{
  "version": "v18",
  "task": "track1_inference_and_packaging",
  "geometry": {
    "max_side": 1024,
    "pad_multiple": 32,
    "interpolation_restored": "INTER_LINEAR",
    "interpolation_masks": "INTER_NEAREST"
  },
  "restoration_pipeline": {
    "base_table": "checkpoints/exp4_1_scale_consistent/tbl19_20sc_scale_consistent.pt",
