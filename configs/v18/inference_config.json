  "segmentation_pipeline": {
    "checkpoint": "checkpoints/v18/segmenter_best.pt",
    "tta": {
      "horizontal_flip": true,
      "multi_scale": false,
      "scales": [448, 518, 588, 672],
      "scale_weights": [0.12, 0.38, 0.25, 0.25]
    },
    "calibration_offsets": [0.0, 0.0, 0.0, 0.15, 0.15],
    "cc_speckle_filter_px": 250
  },
  "output_paths": {
    "dev_source": "data/dev/degraded",
    "out_restored_dir": "deploy/v18/track1_dev_outputs/restored",
    "out_masks_dir": "deploy/v18/track1_dev_outputs/seg_masks",
    "out_zip": "deploy/v18/submission_v18_dual_encoder_sota.zip"
  }
}
